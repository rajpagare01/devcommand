# PostgreSQL configuration (used by both Postgres container and Spring Boot)
POSTGRES_DB=devcommand
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_example

# Spring Boot Database configuration
DATABASE_URL=jdbc:postgresql://postgres:5432/devcommand
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres_password_example

# Spring Boot JWT and CORS configuration
# Must be a long, random string in real environments (32+ bytes).
JWT_SECRET=replace-with-a-long-random-base64-secret-value
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:8081,https://dev-command-ecru.vercel.app

SERVER_PORT=8080

# Telegram Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=


# AI Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# OpenAI Configuration (Production RAG Embeddings)
OPENAI_API_KEY=
AI_RAG_EMBEDDING_PROVIDER=openai
AI_RAG_TOP_K=4
AI_RAG_SIMILARITY_THRESHOLD=0.65

# LeetCode Configuration
LEETCODE_ENABLED=true

