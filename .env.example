# Copy to .env (or export these in your shell) before running the app.

DB_URL=jdbc:postgresql://localhost:5432/devcommand
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Must be a long, random string in real environments (32+ bytes).
# Example generator: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-base64-secret
JWT_EXPIRATION_MS=86400000

SERVER_PORT=8080
